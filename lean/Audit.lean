-- Traverse all project theorems, including private lemmas, and all their proof dependencies.
-- The shared visited set makes this a single traversal of their dependencies.
open Lean Elab Command in
elab "#audit_project_axioms" : command => do
  let env ← getEnv
  let roots := env.constants.fold (init := #[]) fun acc n info =>
    match info, env.getModuleIdxFor? n with
    | .thmInfo _, some i => if (`OnlineMMS).isPrefixOf env.header.moduleNames[i.toNat]! then acc.push n else acc
    | _, _ => acc
  if roots.isEmpty then throwError "No imported project theorems found"
  let (_, result) := ((roots.forM Lean.CollectAxioms.collect).run env).run {}
  let permitted : Array Name := #[``propext, ``Classical.choice, ``Quot.sound]
  let other := result.axioms.filter fun a => !permitted.contains a
  unless other.isEmpty do throwError "Unexpected transitive axioms {other}"
  logInfo m!"Checked {roots.size} project theorems. Transitive axioms {result.axioms}."

#audit_project_axioms
